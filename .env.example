SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST/ps3b_ergon?sslmode=require&channelBinding=require
SPRING_DATASOURCE_USERNAME=ergon_showcase_bulk_runtime
SPRING_DATASOURCE_PASSWORD=REPLACE_LOCALLY
CONFIG_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST/ps3b_config?sslmode=require&channelBinding=require
CONFIG_DATASOURCE_USERNAME=ps3b_config_runtime
CONFIG_DATASOURCE_PASSWORD=REPLACE_LOCALLY
CONFIG_DATASOURCE_SCHEMA=public
PRAXIS_RESOURCE_VERSION_ETAG_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SHOWCASE_USERNAME=ergon
SHOWCASE_PASSWORD=REPLACE_LOCALLY
SHOWCASE_PUBLIC_READ_ENABLED=false
SHOWCASE_CORS_ORIGINS=https://praxis-ergon-showcase.web.app,https://praxis-ergon-showcase.firebaseapp.com,http://localhost:4200,http://localhost:4310
SHOWCASE_CONFIG_ORIGINS=https://praxis-ergon-showcase.web.app,https://praxis-ergon-showcase.firebaseapp.com,http://localhost:4200,http://localhost:4310
# Identidade separada: administra publicação, sem escrita cadastral.
SHOWCASE_BULK_ADMIN_USERNAME=ergon-publication-admin
SHOWCASE_BULK_ADMIN_PASSWORD=REPLACE_WITH_SEPARATE_ADMIN_PASSWORD
SERVER_PORT=8080
BULK_OWNER_USERNAME=neondb_owner
BULK_CONTROL_PASSWORD=REPLACE_WITH_SEPARATE_CONTROL_ROLE_PASSWORD
BULK_CURSOR_KEY=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
# Somente na instalação técnica; não disponibilizar a senha owner ao runtime.
BULK_OWNER_PASSWORD=REPLACE_ONLY_FOR_EXPLICIT_INSTALLATION
BULK_RUNTIME_PASSWORD=REPLACE_WITH_THE_SAME_VALUE_AS_SPRING_DATASOURCE_PASSWORD
# Somente para testes: cópia Neon descartável já provisionada e verificada.
PROOF_NEON_BRANCH=REPLACE_WITH_DISPOSABLE_NEON_BRANCH_ID
BULK_PROOF_DISPOSABLE_BRANCH=REPLACE_WITH_DISPOSABLE_NEON_BRANCH_ID
BULK_PROOF_EXPECTED_HOST=REPLACE_WITH_VERIFIED_DISPOSABLE_NEON_HOST
