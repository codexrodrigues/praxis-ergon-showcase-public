  "operationSemantics": [
    {
      "code": "CERG-07003",
      "appliesTo": [
        "COMMAND_ITEM"
      ],
      "decision": "Homologação coletiva conserva OLD real e verifica DESIGNADA. CRUD/bulk de retificação não podem adquirir essa guarda ao passar OLD completo."
    },
    {
      "code": "ERG-01152/ERG-01153",
      "appliesTo": [
        "CREATE",
        "UPDATE",
        "BULK_ITEM"
      ],
      "decision": "CREATE usa ausência explícita de OLD; não dereferenciar current.titularAtualId quando current=null. UPDATE lê OLD, nunca o candidato."
    },
    {
      "code": "CERG-07151",
      "appliesTo": [
        "CREATE"
      ],
      "decision": "Usar context.lifecycle, sem current.criacao; preview não executa a regra de abertura."
    },
    {
      "code": "DELETE",
      "appliesTo": [
        "DELETE"
      ],
      "decision": "Migrar somente as guardas de exclusão dos serviços para escopo dedicado; não avaliar a família de CREATE com draft=null."
    },
    {
      "code": "PREVIEW",
      "appliesTo": [
        "PREVIEW"
      ],
      "decision": "Admissão verifica cada slot customizado contra o schema específico do preview que o chama."
    }
  ]
